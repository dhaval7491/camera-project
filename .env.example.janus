# Add these environment variables to your .env file

# Janus API Token - Generate a secure token for Janus server authentication
JANUS_API_TOKEN=your-secure-api-token-here-change-this

# AWS S3 Configuration for Recording Storage
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=your-camera-recordings-bucket
AWS_URL=https://your-camera-recordings-bucket.s3.amazonaws.com
AWS_ENDPOINT=

# Recording Configuration
RECORDING_STORAGE_PATH=/opt/janus/share/janus/recordings
RECORDING_TEMP_PATH=/opt/janus/processing/temp
RECORDING_CONVERTED_PATH=/opt/janus/processing/converted
RECORDING_LOG_PATH=/opt/janus/processing/logs

# Video Processing Configuration
VIDEO_QUALITY=23
AUDIO_BITRATE=128k
MAX_PARALLEL_CONVERSIONS=2
CLEANUP_AFTER_DAYS=7